generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SupplyChainTask {
  id                  String         @id
  title               String
  description         String
  productCategory     String
  productName         String?
  quantity            Int?
  material            String?
  dimensions          String?
  process             String?
  colorRequirements   String?
  packagingRequirements String?
  artworkRequirements String?
  budgetRange         String?
  targetMarket        String?
  assetUrls           Json?
  deadline            String?
  shippingDestination String?
  notes               String?
  status              String
  initialAssessment   Json
  quoteRequest        Json?
  orderDraft          Json?
  userConfirmation    Json?
  productionRequest   Json?
  productionFeedback  Json?
  paymentIntent       Json?
  fulfillment         Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  events              TaskEvent[]
  sampleResults       SampleResult[]

  @@index([status])
  @@index([productCategory])
}

model TaskEvent {
  id        String          @id
  taskId    String
  type      String
  message   String?
  metadata  Json?
  createdAt DateTime        @default(now())
  task      SupplyChainTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([type])
}

model SampleResult {
  id               String          @id
  taskId           String
  sampleImages     Json?
  sampleVideos     Json?
  quotedPrice      String?
  productionTime   String?
  supplierFeedback String?
  qualityNotes     String?
  shippingInfo     String?
  createdAt        DateTime        @default(now())
  task             SupplyChainTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
